# ==============================================================================
# Research Brief Multi-Agent Market Research App — Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Note: The app includes offline-first verified benchmarks and built-in web
# search scraping, allowing it to run completely without any external API keys.
# ==============================================================================

# Application Server Configuration
PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
APP_ENV=local

# Default Research Query
DEFAULT_QUERY="Analyze the food delivery market in Nepal."

# (Optional) External Language Model API Configuration
# If you wish to connect an external LLM provider, enter your keys below:
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Research Engine Settings
ENABLE_WEB_SCRAPING=true
RESPECT_ROBOTS_TXT=true
MAX_COMPETITORS=2
MAX_CRITIC_REVISIONS=1
